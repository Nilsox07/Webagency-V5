# Vorlage. Einmal kopieren:  cp .env.example .env
#
# .env wird NIEMALS committet (steht in .gitignore). In dieser Vorlage steht nie ein
# echter Wert — auch kein lokales Passwort.
#
# Die Namen folgen Portal-Lastenheft §1.5. Wer hier umbenennt, bricht die Anwendung.
# Korrigiert am 01.08.2026 nach externer Prüfung: DB_PASSWORD, APP_KEY, MAIL_HOST,
# APP_URL und APP_ENV=development entsprachen nicht der Spezifikation, sieben
# Pflichtwerte fehlten ganz.

# --- Anwendung ---------------------------------------------------------------
# APP_ENV kennt genau drei Werte: local | staging | production
# "development" gibt es nicht — die HTTP-Ausnahme des Setups greift nur bei "local".
APP_ENV=local
BASE_URL=http://localhost:8080
APP_PORT=8080

# Verzeichnis für Uploads, außerhalb von /public
STORAGE_DIR=/var/www/storage

# --- Datenbank ---------------------------------------------------------------
# BEIDE Passwortfelder ausfüllen, sonst startet der Datenbankcontainer nicht.
# Irgendein Wert genügt, er gilt nur lokal. Kein Wert aus einem anderen Projekt.
DB_HOST=db
DB_PORT=3306
DB_NAME=sartu
DB_USER=sartu
DB_PASS=
DB_ROOT_PASSWORD=

# Testdatenbank (Portal-Lastenheft §16 — Datenbanktests laufen gegen echtes MySQL)
DB_HOST_TEST=db_test
DB_NAME_TEST=sartu_test

# --- Mail --------------------------------------------------------------------
# Lokal fängt Mailpit alles ab. Posteingang: http://localhost:8025
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@localhost
MAIL_FROM_NAME=SARTU
MAIL_UI_PORT=8025

# Adresse, an die interne Benachrichtigungen gehen (§10)
ADMIN_NOTIFY_EMAIL=

# --- Schlüssel ---------------------------------------------------------------
# Beide werden in Setup-Schritt 3 erzeugt, nicht von Hand ausgedacht und nie hier
# eingetragen. Je 32 Byte, base64.
# Erzeugen:  docker compose exec app php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
#
# SESSION_SECRET signiert Sitzungen. ENC_KEY verschlüsselt Felder wie totp_secret_enc
# (AES-256-GCM über sodium_*). Wer ENC_KEY verliert, verliert alle TOTP-Geheimnisse.
SESSION_SECRET=
ENC_KEY=

# --- Zweifaktor --------------------------------------------------------------
# Name, den die Authenticator-App neben dem Code anzeigt
ADMIN_TOTP_ISSUER=SARTU
