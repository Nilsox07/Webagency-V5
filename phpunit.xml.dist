<?xml version="1.0" encoding="UTF-8"?>
<!--
  Portal-Lastenheft §16: Datenbanktests laufen gegen ein echtes MySQL/MariaDB.
  Kein SQLite, kein Ersatz im Speicher — SQLite verhaelt sich bei Transaktionen und
  Fremdschluesseln anders, ein gruener Test dort sagt nichts ueber MySQL.

  Ziel ist db_test, nicht die Arbeitsdatenbank. Die Testfaelle leeren Tabellen.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
  <testsuites>
    <testsuite name="SARTU">
      <directory>tests</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory>app</directory>
      <directory>admin</directory>
    </include>
  </source>
</phpunit>
